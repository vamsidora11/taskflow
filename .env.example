# TaskFlow environment variables. Copy to .env and edit. Never commit real secrets.

# --- App ---
# dev | ci | staging | production
APP_ENV=development
# Serve /docs, /redoc and /api/v1/openapi.json (PLAN.md 10A.8). Use false in production.
ENABLE_DOCS=true
# Optional HTTP Basic Auth for docs in staging/demo (not enforced until a later phase).
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASSWORD=
# Allowed CORS origin (the frontend URL)
FRONTEND_ORIGIN=http://localhost:8080

# --- PostgreSQL ---
POSTGRES_DB=taskflow
# Superuser used only to bootstrap the container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Migration role (owns tables) and runtime role (RLS-subject). Roles are created in infra/postgres/init.sql.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER_PASSWORD=change-me-app
# Runtime connection used by the API (app_user)
DATABASE_URL=postgresql+asyncpg://app_user:change-me-app@postgres:5432/taskflow
# Migration connection used by Alembic (owner)
MIGRATION_DATABASE_URL=postgresql+asyncpg://owner:change-me-owner@postgres:5432/taskflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (used from Phase 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Rate limiting (used from Phase 6) ---
RATE_LIMIT_LOGIN_PER_IP=10/minute
RATE_LIMIT_LOGIN_PER_EMAIL=5/15minutes
RATE_LIMIT_REFRESH_PER_IP=30/minute
RATE_LIMIT_WRITE_PER_USER=120/minute
RATE_LIMIT_READ_PER_USER=600/minute

# --- Email (used from Phase 3) ---
# console | smtp
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Ports published by docker compose ---
NGINX_PORT=8080
